{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/stream": "^1.1.0",
    "@elysiajs/swagger": "^1.3.1",
    "@kepler-chat/auth": "workspace:*",
    "@kepler-chat/contracts": "workspace:*",
    "@kepler-chat/db": "workspace:*",
    "@kepler-chat/env": "workspace:*",
    "@kepler-chat/opencode-manager": "workspace:*",
    "@opencode-ai/sdk": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "^1.4.21",
    "nanoid": "^5.1.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kepler-chat/config": "workspace:*",
    "@types/bun": "catalog:",
    "vitest": "^2.1.8",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
